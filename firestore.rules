rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // Nunca confia só no campo `plan` cru, sempre recalcula a expiração
    // contra o horário da própria escrita. `plan`/`planExpiresAt` em
    // users/{uid} só são escritos pelo backend do quemsoueu (SSO / sync
    // de plano via Admin SDK, bypassa regra) — nunca pelo client.
    function isPremiumUser(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path)
        && userDoc(uid).data.plan in ['premium', 'annual']
        && (!('planExpiresAt' in userDoc(uid).data) || userDoc(uid).data.planExpiresAt == null
            || timestamp.value(userDoc(uid).data.planExpiresAt) > request.time);
    }

    match /users/{userId} {
      allow read: if request.auth != null;

      // plan/planExpiresAt só o backend do quemsoueu escreve (Admin SDK,
      // bypassa regra). O client só mexe no próprio perfil e em
      // activeGroupId (controle local de "1 sala ativa por vez").
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'photo', 'lastLogin']);

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'email', 'photo', 'lastLogin', 'activeGroupId']);
    }

    match /cases/{caseId} {
      allow get: if request.auth != null;
      allow list: if request.auth != null;

      // Client nunca cria/apaga caso (só o Admin SDK, via
      // api/cases/replenish.ts) — só pode marcar um disponível como usado,
      // e só tocando exatamente esses 3 campos (nunca reescreve conteúdo do
      // caso em si).
      allow update: if request.auth != null
        && resource.data.status == 'available'
        && request.resource.data.status == 'used'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'usedAt', 'usedByRoomId']);
    }

    // A solução (quem é o culpado) nunca é lida nem escrita pelo client —
    // só o Admin SDK toca aqui (api/cases/replenish.ts grava, api/cases/
    // reveal.ts lê). Se um dia isso vazasse por uma regra frouxa, qualquer
    // jogador poderia ver a resposta antes de votar.
    match /case_solutions/{caseId} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      // Só o anfitrião controla a fase do caso — sem isso, qualquer membro
      // da sala poderia forçar avançar a investigação ou revelar o
      // resultado sem passar pelo botão do host. `solution` também é
      // travado aqui: só chega no doc via api/cases/reveal.ts (Admin SDK,
      // bypassa esta regra) — o client nunca escreve essa chave.
      function isHostControlledFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['status', 'caseId', 'currentClueIndex', 'adminId', 'solution']);
      }

      // Mesmo o anfitrião nunca escreve status:'REVEAL' direto — só
      // api/cases/reveal.ts faz essa transição (via Admin SDK, que bypassa
      // esta regra), depois de validar server-side que a sala está mesmo
      // em VOTING. Sem isso, o próprio host poderia forjar uma solução
      // qualquer direto no client.
      function isNotClientReveal() {
        return request.resource.data.status != 'REVEAL';
      }

      // Cada jogador só pode escrever a própria chave em `votes` (mapa por
      // uid) — nunca o voto de outro jogador. `votes` fica fora do array
      // `members` justamente porque array de mapas não dá pra travar por
      // regra elemento a elemento; mapa por uid dá.
      function isOwnVoteOnly() {
        let beforeVotes = resource.data.get('votes', {});
        let afterVotes = request.resource.data.get('votes', {});
        return afterVotes.diff(beforeVotes).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.adminId
        && request.resource.data.memberIds.size() == 1
        && (
          isPremiumUser(request.auth.uid)
          || !('activeGroupId' in userDoc(request.auth.uid).data)
          || userDoc(request.auth.uid).data.activeGroupId == null
        );

      allow update: if request.auth != null
        && (request.auth.uid in resource.data.memberIds || request.auth.uid in request.resource.data.memberIds)
        && (request.auth.uid == resource.data.adminId || isHostControlledFieldsUnchanged())
        && (request.auth.uid == resource.data.adminId || isOwnVoteOnly())
        && isNotClientReveal()
        && (
          request.resource.data.members.size() <= resource.data.members.size()
          || request.resource.data.members.size() <= 5
          || isPremiumUser(resource.data.adminId)
        );

      allow delete: if request.auth != null && request.auth.uid == resource.data.adminId;
    }
  }
}
